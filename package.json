{
  "name": "zhiyu-health-map",
  "version": "0.0.1-beta.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-figure-font.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "content:build": "node scripts/build-content-catalog.mjs",
    "content:check": "node scripts/build-content-catalog.mjs --check",
    "test:content": "npm run content:check && node --test scripts/content.test.mjs",
    "test:routes": "node --test scripts/routes.test.mjs",
    "test:discovery": "node --test scripts/discovery.test.mjs",
    "test:search": "node --test scripts/search.test.mjs",
    "test:topics": "node --test scripts/topics.test.mjs",
    "test:share": "node --test scripts/share.test.mjs",
    "test:guide": "node --test scripts/reading-guide.test.mjs",
    "test:learning": "node scripts/visual-learning-smoke.mjs",
    "test:expansion": "node scripts/content-expansion-smoke.mjs",
    "test:figure": "node scripts/figure-smoke.mjs",
    "test:report": "node scripts/report-smoke.mjs",
    "test:report-data": "node --test scripts/report-guide.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "fonts:build": "node scripts/build-figure-font.mjs"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "@playwright/test": "^1.51.0",
    "subset-font": "^2.9.0"
  }
}
