  "tags": ["空腹血糖", "糖化血红蛋白"],
  "number": "01",
  "desc": "血糖是血液中的葡萄糖，是身体的重要能量来源。胰岛素帮助葡萄糖进入细胞，肝脏则像仓库一样储存或释放糖。",
  "metrics": [
    {
      "name": "空腹血糖（FPG）",
      "text": "观察至少 8 小时未摄入热量时的血糖水平，像一张当下的快照。",
      "sourceIds": ["tests"]
    },
    {
      "name": "糖化血红蛋白（HbA1c）",
      "text": "反映过去约 2–3 个月的平均血糖情况。贫血、血红蛋白变异等可能影响结果。",
      "sourceIds": ["tests"]
    },
    {
      "name": "口服葡萄糖耐量试验（OGTT）",
      "text": "观察喝下规定葡萄糖溶液后身体处理糖的能力，需按医疗机构规范进行。",
      "sourceIds": ["tests"]
    }
  ],
