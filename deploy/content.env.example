POSTGRES_PASSWORD=replace-with-a-strong-random-password
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SERVER_URL=https://example.com
COOKIE_SECURE=true
CMS_PORT=3108
# Enable only for a clearly labelled beta / demonstration site.
ENABLE_DEMO_API=false
SITE_CONTENT_CHANNEL=official
# Enable only behind a trusted proxy that overwrites X-Real-IP; otherwise limits are shared.
FEEDBACK_TRUST_PROXY=false
# Internal image generation (compose service "imagegen", bound to 127.0.0.1).
# IMAGE_API_BASE points at the OpenAI-compatible origin, e.g. https://clippers.anron.fun/v1
IMAGE_API_BASE=https://api.example.com/v1
IMAGE_API_KEY=replace-with-the-upstream-api-key
IMAGE_SERVICE_TOKEN=replace-with-a-strong-random-token
IMAGE_PORT=3120
IMAGE_MODEL=gpt-image-2.6
IMAGE_MAX_CONCURRENCY=2
IMAGE_DAILY_LIMIT=200
# Public origin this service is proxied under. Leave empty for loopback-only.
# Setting it makes image URLs absolute and enables CORS for that origin only.
IMAGE_PUBLIC_ORIGIN=
IMAGE_ALLOW_BROWSER=false
