# Full-site Next.js deployment. Add HTTPS using your certificate provider.
# Replace the domain and match the upstream port to private CMS_PORT.
# Unlike nginx.conf.example, public pages are NOT served from dist/index.html.
server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ~ /\. { deny all; }

    # Do not expose old bundled medical JSON as a bypass around withdrawal.
    location ^~ /content/ { return 404; }

    location / {
        proxy_pass http://127.0.0.1:3108;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_cache off;
        proxy_intercept_errors off;
    }
}
