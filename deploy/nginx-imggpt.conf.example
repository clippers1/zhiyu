# Public face of the internal image service: imggpt.anron.fun
#
# What is exposed: the generation API, the generated files, and /healthz.
# What stays loopback-only: the admin page (/), /api/state, /api/images, /usage.
#
# Install (this host):
#   sudo install -m 644 deploy/nginx-imggpt.conf.example /etc/nginx/sites-available/imggpt.anron.fun.conf
#   sudo ln -sf /etc/nginx/sites-available/imggpt.anron.fun.conf /etc/nginx/sites-enabled/imggpt.anron.fun
#   sudo certbot certonly --webroot -w /var/www/letsencrypt -d imggpt.anron.fun
#   sudo nginx -t && sudo systemctl reload nginx
#
# IMAGE_PUBLIC_ORIGIN must be https://imggpt.anron.fun so image URLs in JSON
# responses are absolute and open from anywhere.

server {
    listen 80;
    listen [::]:80;
    server_name imggpt.anron.fun;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://imggpt.anron.fun$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name imggpt.anron.fun;

    ssl_certificate /etc/letsencrypt/live/imggpt.anron.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/imggpt.anron.fun/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    access_log /var/log/nginx/imggpt.access.log;
    error_log /var/log/nginx/imggpt.error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # The service rejects anything over 64 KB itself; this is the edge copy.
    client_max_body_size 64k;

    # One image takes 15–60s upstream; the client timeout must exceed it.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 5s;
    proxy_read_timeout 330s;
    proxy_send_timeout 330s;
    proxy_cache off;

    # Optional coarse ceiling against accidental loops. The real quota is the
    # service's own concurrency/queue/daily limit. Uncomment after defining the
    # zone below, otherwise nginx refuses to start.
    # limit_req zone=imggpt_api burst=20 nodelay;

    location = /v1/images {
        proxy_pass http://127.0.0.1:3120;
    }
    location = /v1/images/generations {
        proxy_pass http://127.0.0.1:3120;
    }
    location ^~ /files/ {
        proxy_pass http://127.0.0.1:3120;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:3120;
    }

    location / {
        return 404;
    }
}

# To enable the rate limit, add to the http{} block (or a file in
# /etc/nginx/conf.d/), then uncomment the limit_req directive above:
#
#   limit_req_zone $binary_remote_addr zone=imggpt_api:10m rate=30r/m;
