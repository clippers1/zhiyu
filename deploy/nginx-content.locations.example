# Add inside the same HTTPS server block as the frontend.
# CMS port must match CMS_PORT in the private Compose environment.
# Keep the History/static-file locations from nginx.conf.example as well.
location ~ ^/(admin(?:/|$)|_next/|api/) {
    proxy_pass http://127.0.0.1:3108;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_cache off;
}
