# Expose ONLY the generation API and its images. The admin page stays local.
# Add inside the existing HTTPS server block for the chosen hostname, or use
# this file as its own server block together with the usual Certbot include.
#
#   proxy_pass http://127.0.0.1:3120;   (IMAGE_PORT in the private env file)
#   IMAGE_PUBLIC_ORIGIN must equal https://<this hostname>
#
# The Authorization header is forwarded untouched; the service checks it.
# Do not put this location behind HTTP Basic Auth or a cookie login: external
# agents call it with a bearer token.

location = /v1/images {
    proxy_pass http://127.0.0.1:3120;
    include /etc/nginx/snippets/zhiyu-imagegen-proxy.conf;
}
location = /v1/images/generations {
    proxy_pass http://127.0.0.1:3120;
    include /etc/nginx/snippets/zhiyu-imagegen-proxy.conf;
}
location ^~ /files/ {
    proxy_pass http://127.0.0.1:3120;
    include /etc/nginx/snippets/zhiyu-imagegen-proxy.conf;
}
location = /healthz {
    proxy_pass http://127.0.0.1:3120;
    include /etc/nginx/snippets/zhiyu-imagegen-proxy.conf;
}

# Everything else for this hostname (/, /admin, /api/*, /usage) stays private:
location / {
    return 404;
}

# ---------------------------------------------------------------------------
# /etc/nginx/snippets/zhiyu-imagegen-proxy.conf
#
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header Authorization $http_authorization;
#   proxy_connect_timeout 5s;
#   # Image generation takes 15–60s; keep this above IMAGE_TIMEOUT_MS/1000 + 30.
#   proxy_read_timeout 330s;
#   proxy_send_timeout 330s;
#   proxy_cache off;
#   # Streaming responses are JSON only; buffering is fine.
#   proxy_buffering on;
